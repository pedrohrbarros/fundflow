# ─────────────────────────────────────────────────────────────
# Fundflow environment variables
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL / Supabase) ──────────────────────────
# Runtime connection string. Use the Supabase Supavisor pooler URL in
# production (the direct db.<ref>.supabase.co host is IPv6-only).
# Supabase: Project Settings → Database → Connection string.
DATABASE_URL=""

# ── Redis (cache) ─────────────────────────────────────────────
REDIS_URL=""

# ── Auth: Google Sign-In ──────────────────────────────────────
# OAuth 2.0 Web client ID from Google Cloud Console
# (APIs & Services → Credentials → OAuth client ID → Web application).
# Ends in `.apps.googleusercontent.com`. This is the expected `aud`
# when verifying the Google ID token, so the FRONTEND must sign in
# with this SAME client ID.
GOOGLE_CLIENT_ID=""

# Secret used to sign the backend's own access JWTs (HS256).
# Generate a strong one: `openssl rand -hex 32`
# Use a different value per environment; rotating it invalidates all
# issued access tokens.
JWT_SECRET=""

# Static key that gates Swagger "docs mode" only (X-Api-Key header,
# which auto-provisions a monthly test user). NOT used for normal
# user auth. Generate: `openssl rand -hex 32`
API_TOKEN=""

# ── CORS / server ─────────────────────────────────────────────
# JSON array of allowed origins (must be valid JSON, or the app throws).
# Defaults to ["http://localhost:3000"] when unset.
ALLOWED_ORIGINS='["http://localhost:3000"]'

# Port the API listens on (optional; defaults to 8000).
PORT=8000

# Optional: "development" | "production" | "test" (affects rate-limit skip in tests).
NODE_ENV=development

# Optional: pino log level — "trace" | "debug" | "info" | "warn" | "error" (defaults to info).
LOG_LEVEL=info
