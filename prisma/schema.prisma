generator client {
  provider = "prisma-client"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id                BigInt           @id @default(autoincrement())
  external_id       String           @unique
  email             String           @unique
  country           String           @default("BR")
  categories        Category[]
  sources_of_income SourceOfIncome[]
  payment_methods   PaymentMethod[]
  expenses          Expense[]
  refresh_tokens    RefreshToken[]
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  @@map("users")
}

model RefreshToken {
  id         BigInt   @id @default(autoincrement())
  token_hash String   @unique
  user_id    BigInt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("refresh_tokens")
}

model Category {
  id                BigInt           @id @default(autoincrement())
  name              String
  type              CategoryType
  user_id           BigInt
  user              User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sources_of_income SourceOfIncome[]
  expenses          Expense[]
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  @@map("source_of_income_categories")
}

model SourceOfIncome {
  id           BigInt                 @id @default(autoincrement())
  name         String
  category_id  BigInt?
  income       Float                  @default(0)
  currency     String                 @default("USD")
  date         DateTime               @db.Date
  is_recurring Boolean                @default(false)
  user_id      BigInt
  user         User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category     Category?              @relation(fields: [category_id], references: [id])
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt

  @@map("sources_of_income")
}

model PaymentMethod {
  id         BigInt                 @id @default(autoincrement())
  name       String
  origin     String
  receiver   String?
  user_id    BigInt
  user       User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expenses   ExpensePaymentMethod[]
  created_at DateTime               @default(now())
  updated_at DateTime               @updatedAt

  @@map("payment_methods")
}

model Expense {
  id              BigInt                 @id @default(autoincrement())
  name            String
  category_id     BigInt?
  category        Category?              @relation(fields: [category_id], references: [id])
  amount          Float
  date            DateTime               @db.Date
  is_recurring     Boolean                @default(false)
  recurring_months Int?
  is_paid          Boolean                @default(false)
  is_saved         Boolean                @default(false)
  saving_location  String?
  user_id          BigInt
  user            User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment_methods ExpensePaymentMethod[]
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt

  @@map("expenses")
}

model ExpensePaymentMethod {
  expense_id        BigInt
  payment_method_id BigInt
  partial_amount    Float
  expense           Expense       @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  payment_method    PaymentMethod @relation(fields: [payment_method_id], references: [id], onDelete: Cascade)
  created_at        DateTime      @default(now())

  @@id([expense_id, payment_method_id])
  @@map("expense_payment_methods")
}
